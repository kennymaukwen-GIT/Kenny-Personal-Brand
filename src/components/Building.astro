---
import type { Lang } from '../config/site';
import { clips } from '../config/media';
import { t } from '../i18n';
import LazyVideo from './LazyVideo.astro';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).building;
---

<section class="section" id="building">
  <div class="wrap grid">
    <div class="body reveal">
      <p class="kicker">{d.kicker}</p>
      <SplitText class="h-lg" text={d.title} />
      <p class="status muted"><span class="dot"></span>{d.status}</p>
      <p class="lead">{d.body}</p>
      <a class="btn btn-ghost" href="#buildlog">{d.cta} <span class="arrow">→</span></a>
    </div>
    <div class="panel media spot reveal" style="--d:.1s" aria-hidden="true">
      <LazyVideo src={clips.orrery.src} />
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .body {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 14px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .media {
    aspect-ratio: 4 / 3;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
