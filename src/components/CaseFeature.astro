---
import type { Lang } from '../config/site';
import { t, localePath } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).caseFeature;
---

<section class="section" id="case">
  <div class="wrap">
    <p class="kicker reveal">{d.kicker}</p>
    <h2 class="h-lg reveal" style="--d:.05s">{d.title}</h2>
    <p class="lead reveal" style="--d:.1s">{d.body}</p>

    <div class="stats">
      {
        d.stats.map((s, i) => (
          <div class="stat reveal" style={`--d:${0.1 + i * 0.08}s`}>
            <span class="value">{s.value}</span>
            <span class="label">{s.label}</span>
          </div>
        ))
      }
    </div>

    <div class="foot reveal">
      <p class="h-md">“{d.thesis}”</p>
      <a class="btn btn-ghost" href={localePath(lang, '/work/hsinchu-car-dealer')}>
        {d.cta} <span class="arrow">→</span>
      </a>
    </div>
    <p class="note muted">{d.note}</p>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
  }
  h2 {
    max-width: 18ch;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 32px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stat {
    padding: 32px 28px;
    display: grid;
    gap: 8px;
    background: var(--bg);
  }
  .value {
    font-size: clamp(44px, 5.5vw, 72px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .label {
    color: var(--fg-2);
    font-size: 15px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: 16px;
  }
  .foot p {
    margin: 0;
  }
  .note {
    font-size: 13px;
    margin: 0;
  }
  @media (max-width: 720px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
