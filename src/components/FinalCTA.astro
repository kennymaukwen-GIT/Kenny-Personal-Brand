---
import { site, type Lang } from '../config/site';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).final;
// Without a newsletter service yet, the form falls back to opening an email.
const action = site.newsletterAction || `mailto:${site.email}?subject=Build%20Log`;
const method = site.newsletterAction ? 'post' : 'get';
---

<section class="section final">
  <div class="wrap">
    <SplitText class="h-xl" text={d.title.join(' ')} />
    <p class="lead reveal" style="--d:.05s">{d.sub}</p>
    <a class="btn btn-primary reveal" style="--d:.1s" href={site.bookingUrl} target="_blank" rel="noopener">
      {d.primary} <span class="arrow">→</span>
    </a>

    <form class="news reveal" id="buildlog" action={action} method={method}>
      <div>
        <strong>{d.newsletterTitle}</strong>
        <span class="muted">{d.newsletterBody}</span>
      </div>
      <div class="field">
        <label class="sr-only" for="email">Email</label>
        <input id="email" name="email" type="email" required placeholder={d.newsletterPlaceholder} autocomplete="email" />
        <button class="btn btn-ghost" type="submit">{d.newsletterButton}</button>
      </div>
    </form>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
    justify-items: center;
    text-align: center;
  }
  h2 {
    max-width: 14ch;
  }
  .news {
    margin-top: 72px;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    text-align: left;
  }
  .news > div:first-child {
    display: grid;
    gap: 2px;
  }
  .news .muted {
    font-size: 14px;
  }
  .field {
    display: flex;
    gap: 8px;
    flex: 1;
    max-width: 440px;
    min-width: 260px;
  }
  input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid var(--line-strong);
    background: var(--bg-2);
  }
  input:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>
