---
import { site, type Lang } from '../config/site';
import { t, localePath, otherLang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const social = Object.entries(site.social).filter(([, url]) => url);
---

<footer class="footer">
  <div class="wrap">
    <div class="giant" aria-hidden="true"><span>Seen.</span> <span class="it">Found.</span> <span>Used.</span></div>
    <div class="row">
      <div class="col">
        <strong>{site.name}</strong>
        <span class="muted">{site.location}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="col links">
        {social.map(([name, url]) => <a href={url} target="_blank" rel="noopener">{name}</a>)}
        <a href={localePath(lang, '/privacy')}>{d.footer.privacy}</a>
        <a href={localePath(otherLang(lang), path)}>{d.nav.langLabel}</a>
      </div>
    </div>
    <div class="row small muted">
      <span>© {year} {site.name}. {d.footer.rights}</span>
      <span class="built"><span class="dot"></span>{d.footer.built}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    border-top: 1.5px solid var(--ink);
    padding: 64px 0 36px;
    overflow: hidden;
    background: var(--paper-3);
  }
  .giant {
    font-family: var(--font-display);
    font-size: clamp(56px, 13.5vw, 220px);
    line-height: 0.9;
    letter-spacing: -0.03em;
    white-space: nowrap;
    margin-bottom: 56px;
  }
  .giant span:nth-child(1) {
    color: var(--p1);
  }
  .giant span:nth-child(2) {
    color: var(--p2);
  }
  .giant span:nth-child(3) {
    color: var(--p3);
  }
  .giant span {
    transition: color 1s;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .col strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 26px;
  }
  .links {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 24px;
    text-transform: capitalize;
  }
  .links a,
  .col a {
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }
  .links a:hover,
  .col a:hover {
    text-decoration-color: var(--p2);
  }
  .small {
    font-size: 14px;
    margin: 0;
  }
  .built {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--p2);
  }
</style>
