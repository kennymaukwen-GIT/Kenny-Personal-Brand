---
import Base from '../layouts/Base.astro';
import LazyVideo from '../components/LazyVideo.astro';
import { site, type Lang } from '../config/site';
import { clips } from '../config/media';
import { t, localePath } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).caseStudy;
const path = '/work/hsinchu-car-dealer';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.metaDescription,
  inLanguage: lang === 'en' ? 'en' : 'zh-Hant-TW',
  author: { '@type': 'Organization', name: site.name, url: site.url },
  about: ['AI SEO', 'Generative engine optimization', 'Used car dealer marketing'],
  mainEntityOfPage: new URL(localePath(lang, path), site.url).href,
};
---

<Base lang={lang} path={path} title={d.metaTitle} description={d.metaDescription} jsonLd={[articleLd]}>
  <article>
    <header class="cs-hero">
      <div class="wrap">
        <a class="back" href={localePath(lang, '/')}>← {d.back}</a>
        <p class="kicker reveal">{d.kicker}</p>
        <h1 class="h-lg reveal" style="--d:.1s">{d.title}</h1>
        <dl class="meta reveal" style="--d:.2s">
          <div><dt class="muted">Client</dt><dd>{d.client}</dd></div>
          <div><dt class="muted">Scope</dt><dd>{d.services}</dd></div>
        </dl>
        <div class="panel media reveal" style="--d:.3s" aria-hidden="true">
          <LazyVideo src={clips.concept.src} />
        </div>
      </div>
    </header>

    <section class="section body">
      <div class="wrap narrow">
        {
          d.sections.map((s) => (
            <div class="block reveal">
              <h2 class="h-md">{s.h}</h2>
              <p class="lead">{s.p}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section funnel-sec">
      <div class="wrap">
        <p class="kicker reveal">{d.funnelTitle}</p>
        <ol class="funnel">
          {
            d.funnel.map((f, i) => (
              <li class="reveal" style={`--d:${i * 0.12}s; --w:${100 - i * 22}%`}>
                <span class="value">{f.value}</span>
                <span class="label">{f.label}</span>
              </li>
            ))
          }
        </ol>
        <p class="lead reveal">{d.funnelNote}</p>
      </div>
    </section>

    <section class="section ai">
      <div class="wrap narrow">
        <div class="block reveal">
          <h2 class="h-md">{d.aiTitle}</h2>
          <p class="lead">{d.aiBody}</p>
        </div>
        <blockquote class="h-md reveal">“{d.takeaway}”</blockquote>
        <p class="note muted reveal">{d.note}</p>
      </div>
    </section>

    <section class="section cta">
      <div class="wrap">
        <h2 class="h-lg reveal">{d.ctaTitle}</h2>
        <a class="btn btn-primary reveal" style="--d:.1s" href={site.bookingUrl} target="_blank" rel="noopener">
          {d.cta} <span class="arrow">→</span>
        </a>
      </div>
    </section>
  </article>
</Base>

<style>
  .cs-hero {
    padding: 140px 0 0;
  }
  .cs-hero .wrap {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .cs-hero h1 {
    max-width: 20ch;
  }
  .back {
    font-size: 14px;
    color: var(--fg-2);
  }
  .back:hover {
    color: var(--fg);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 48px;
    margin: 8px 0 0;
    font-size: 14px;
  }
  .meta dd {
    margin: 2px 0 0;
  }
  .media {
    width: 100%;
    aspect-ratio: 21 / 9;
    margin-top: 40px;
  }
  .narrow {
    display: grid;
    gap: 56px;
  }
  .narrow > * {
    max-width: 760px;
  }
  .block {
    display: grid;
    gap: 12px;
  }
  .funnel-sec .wrap {
    display: grid;
    gap: 24px;
  }
  .funnel {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: grid;
    gap: 8px;
  }
  .funnel li {
    width: var(--w);
    min-width: min(100%, 300px);
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 20px 24px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .funnel .value {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .funnel .label {
    color: var(--fg-2);
  }
  blockquote {
    margin: 0;
  }
  .note {
    font-size: 13px;
  }
  .cta .wrap {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
</style>
