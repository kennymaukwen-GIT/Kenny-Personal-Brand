---
import type { Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).process;
---

<section class="section process">
  <div class="wrap">
    <p class="kicker reveal">{d.kicker}</p>
    <h2 class="h-lg reveal" style="--d:.1s">{d.title}</h2>
    <ol class="steps">
      {
        d.steps.map((s, i) => (
          <li class="step reveal" style={`--d:${i * 0.1}s`}>
            <span class="n">{s.n}</span>
            <h3 class="h-md">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1.5px solid var(--ink);
  }
  .step {
    padding: 28px 24px 8px 0;
    display: grid;
    gap: 12px;
    align-content: start;
    border-right: 1px solid var(--line);
  }
  .step:not(:first-child) {
    padding-left: 24px;
  }
  .step:last-child {
    border-right: 0;
  }
  .n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 64px;
    line-height: 0.8;
    color: var(--p1);
    transition: color 1s;
  }
  .step:nth-child(2) .n {
    color: var(--p2);
  }
  .step:nth-child(3) .n {
    color: var(--p3);
  }
  .step:nth-child(4) .n {
    color: var(--p4);
  }
  .step p {
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
  }
  @media (max-width: 960px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
    .step:nth-child(3) {
      padding-left: 0;
    }
    .step:nth-child(2) {
      border-right: 0;
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
    .step,
    .step:not(:first-child) {
      padding: 22px 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
