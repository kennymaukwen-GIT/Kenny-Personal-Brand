---
import type { Lang } from '../config/site';
import { t, localePath } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).projects;
const home = localePath(lang, '/');
const hrefFor: Record<string, string> = {
  case: localePath(lang, '/work/hsinchu-car-dealer'),
  building: `${home}#building`,
  work: `${home}#work`,
};
---

<section class="section" id="projects">
  <div class="wrap">
    <p class="kicker scramble">{d.kicker}</p>
    <SplitText class="h-lg" text={d.title} />
    <div class="grid">
      {
        d.items.map((p, i) => {
          const href = p.link ? hrefFor[p.link] : undefined;
          const Tag = href ? 'a' : 'div';
          return (
            <Tag class="card spot reveal" style={`--d:${i * 0.08}s`} href={href} data-cursor-label={href ? 'View' : undefined}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="tag">{p.pillar}</span>
              <h3 class="h-md">{p.name}</h3>
              <p>{p.body}</p>
              {href && <span class="arrow">↗</span>}
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 32px;
  }
  .card {
    position: relative;
    display: grid;
    gap: 14px;
    align-content: start;
    min-height: 260px;
    padding: 32px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-2);
    overflow: hidden;
    transition: border-color 0.4s, transform 0.6s var(--ease);
  }
  a.card:hover {
    border-color: var(--line-strong);
    transform: translateY(-4px);
  }
  .idx {
    position: absolute;
    right: 24px;
    bottom: -18px;
    font-size: 140px;
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.08);
    pointer-events: none;
    transition: -webkit-text-stroke-color 0.4s;
  }
  .card:hover .idx {
    -webkit-text-stroke-color: rgba(124, 108, 255, 0.5);
  }
  .tag {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(124, 108, 255, 0.15);
    color: #c4bcff;
  }
  p {
    margin: 0;
    max-width: 44ch;
    color: var(--fg-2);
    font-size: 15px;
  }
  .arrow {
    position: absolute;
    top: 28px;
    right: 28px;
    font-size: 20px;
    color: var(--fg-2);
    transition: transform 0.4s var(--ease), color 0.4s;
  }
  a.card:hover .arrow {
    transform: translate(3px, -3px);
    color: var(--fg);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
