---
// Giant marquee whose speed and direction follow your scrolling.
import type { Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const items = t(Astro.props.lang).marquee;
const loop = [...items, ...items, ...items];
---

<div class="marquee" aria-label={items.join(', ')}>
  <div class="track" data-marquee aria-hidden="true">
    {
      loop.map((item, i) => (
        <span class:list={['item', { outline: i % 2 === 1 }]}>
          {item}
          <i>✳</i>
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 26px 0;
    overflow: hidden;
  }
  .track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .item {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    font-size: clamp(48px, 8vw, 120px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
  }
  .outline {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.45);
  }
  i {
    font-style: normal;
    font-size: 0.4em;
    color: var(--accent);
  }
</style>
