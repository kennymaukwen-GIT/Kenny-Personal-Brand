---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Film from '../components/Film.astro';
import Statement from '../components/Statement.astro';
import Rotator from '../components/Rotator.astro';
import LayerStack from '../components/LayerStack.astro';
import Carousel from '../components/Carousel.astro';
import Capabilities from '../components/Capabilities.astro';
import CaseFeature from '../components/CaseFeature.astro';
import Latest from '../components/Latest.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { site, type Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

// Pricing rows double as an FAQ for AI assistants and rich results.
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: lang === 'en' ? `What does ${site.name} do?` : `${site.name} 做什麼？`,
      acceptedAnswer: { '@type': 'Answer', text: d.meta.description },
    },
    ...d.pricing.rows.map((r) => ({
      '@type': 'Question',
      name: lang === 'en' ? `How much does "${r.service}" cost?` : `「${r.service}」多少錢？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `${r.note}. ${d.pricing.tiers.map((tier, i) => (r.prices[i] ? `${tier.name}: ${r.prices[i]}` : '')).filter(Boolean).join(' · ')}. ${d.pricing.footnote}`,
      },
    })),
  ],
};
---

<Base lang={lang} path="/" jsonLd={[faq]} announce>
  <Hero lang={lang} />
  <Film lang={lang} />
  <div class="pair">
    <Statement lang={lang} />
    <LayerStack lang={lang} />
  </div>
  <div class="pair">
    <Rotator lang={lang} />
    <Carousel lang={lang} />
  </div>
  <div class="sheet white">
    <Capabilities lang={lang} />
    <CaseFeature lang={lang} />
  </div>
  <Latest lang={lang} />
  <div class="sheet grey">
    <Pricing lang={lang} />
    <Process lang={lang} />
  </div>
  <CtaBlock lang={lang} />
</Base>

<style>
  .pair {
    position: relative;
  }
  .pair > :global(*:last-child) {
    position: relative;
    z-index: 2;
  }
  .white {
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
  }
  .grey {
    background: var(--g1);
  }
</style>
