---
// Inset video card with live "AI annotation" boxes labelling what the studio builds.
import { site, type Lang } from '../config/site';
import { heroClip } from '../config/media';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const h = d.hero;
// Box positions (percent of the frame) and drift paths.
const boxes = [
  { x: 6, y: 58, w: 22, h: 26, dx: 3, dy: -2 },
  { x: 66, y: 18, w: 18, h: 20, dx: -2, dy: 3 },
  { x: 74, y: 62, w: 16, h: 22, dx: -3, dy: -2 },
  { x: 14, y: 16, w: 14, h: 18, dx: 2, dy: 2 },
  { x: 44, y: 70, w: 12, h: 14, dx: 2, dy: -3 },
  { x: 52, y: 8, w: 10, h: 12, dx: -2, dy: 2 },
];
---

<section class="hero sheet" data-zoom aria-labelledby="hero-title">
  <video class="vid" src={heroClip.src} autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
  <div class="shade" aria-hidden="true"></div>
  <div class="boxes" aria-hidden="true">
    {
      boxes.map((b, i) => (
        <span
          class={`box b${i % 3}`}
          style={`--x:${b.x}%;--y:${b.y}%;--w:${b.w}%;--h:${b.h}%;--dx:${b.dx}%;--dy:${b.dy}%;--t:${7 + i * 1.3}s;--delay:${0.6 + i * 0.25}s`}>
          <em>{d.heroTags[i]}</em>
        </span>
      ))
    }
  </div>
  <div class="copy" data-zoom-copy>
    <SplitText tag="h1" id="hero-title" class="h-xl" text={h.title.join(' ')} delay={0.2} />
    <p class="sub reveal" style="--d:.6s">{h.sub}</p>
    <div class="ctas reveal" style="--d:.75s">
      <a class="btn btn-primary light" href={site.bookingUrl} target="_blank" rel="noopener">{h.primary}</a>
      <a class="btn btn-glass" href="#capabilities">{d.nav.services}</a>
    </div>
  </div>
  <a class="cue" href="#film">{h.scroll} <span>↓</span></a>
</section>

<style>
  .hero {
    transform-origin: 50% 0;
    will-change: transform;
    height: calc(100svh - 60px - 32px - 16px);
    min-height: 560px;
    color: #fff;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .hero > .vid {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.45));
  }
  .boxes {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .box {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: var(--h);
    border: 1.5px solid #4f8cff;
    background: rgba(79, 140, 255, 0.14);
    opacity: 0;
    animation:
      boxIn 0.6s var(--ease) var(--delay) forwards,
      drift var(--t) ease-in-out var(--delay) infinite alternate;
  }
  .box.b1 {
    border-color: #f5a524;
    background: rgba(245, 165, 36, 0.12);
  }
  .box.b2 {
    border-color: #e5484d;
    background: rgba(229, 72, 77, 0.12);
  }
  .box em {
    position: absolute;
    left: -1.5px;
    top: -20px;
    padding: 2px 6px;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 11px;
    background: #4f8cff;
    color: #fff;
    white-space: nowrap;
  }
  .b1 em {
    background: #f5a524;
    color: #000;
  }
  .b2 em {
    background: #e5484d;
  }
  @keyframes boxIn {
    from {
      opacity: 0;
      transform: scale(1.3);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes drift {
    to {
      translate: var(--dx) var(--dy);
    }
  }
  .copy {
    display: grid;
    gap: 20px;
    justify-items: center;
    text-align: center;
    padding: 0 24px;
  }
  .copy :global(h1) {
    max-width: 16ch;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25);
  }
  .sub {
    max-width: 52ch;
    margin: 0;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.85);
  }
  .ctas {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .light {
    background: #fff;
    color: #000;
  }
  .btn-glass {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
    backdrop-filter: blur(8px);
  }
  .cue {
    position: absolute;
    right: 24px;
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }
  .cue span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 4px;
  }
  @media (max-width: 700px) {
    .box:nth-child(n + 4) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .box {
      animation: none;
      opacity: 1;
    }
  }
</style>
