---
import Base from '../layouts/Base.astro';
import LazyVideo from '../components/LazyVideo.astro';
import { clips } from '../config/media';
import { t } from '../i18n';

const d = t('en').notFound;
---

<Base lang="en" path="/404" title={d.title}>
  <section class="nf">
    <div class="bg" aria-hidden="true"><LazyVideo src={clips.door.src} /></div>
    <div class="wrap">
      <p class="kicker">404</p>
      <h1 class="h-xl">{d.title}</h1>
      <p class="lead">{d.body}</p>
      <a class="btn btn-primary" href="/">{d.cta} <span class="arrow">→</span></a>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.4;
  }
  .wrap {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
</style>
