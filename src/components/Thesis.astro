---
import type { Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).thesis;
---

<section class="section">
  <div class="wrap">
    <p class="kicker reveal">{d.kicker}</p>
    <h2 class="h-lg reveal" style="--d:.05s">
      {d.line} <span class="muted">{d.accent}</span>
    </h2>
    <p class="lead reveal" style="--d:.1s">{d.body}</p>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
  }
  h2 {
    max-width: 20ch;
  }
</style>
