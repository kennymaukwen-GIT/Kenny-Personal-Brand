---
import { site, type Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).pricing;
---

<section class="section pricing" id="services">
  <div class="wrap">
    <p class="kicker reveal">{d.kicker}</p>
    <h2 class="h-lg reveal" style="--d:.1s">{d.title}</h2>
    <p class="lead reveal" style="--d:.2s">{d.sub}</p>

    <div class="table reveal" role="table" aria-label={d.title}>
      <div class="tr thead" role="row">
        <div class="th svc" role="columnheader"></div>
        {
          d.tiers.map((tier, i) => (
            <div class={`th tier ${i === 1 ? 'hl' : ''}`} role="columnheader">
              <strong>{tier.name}</strong>
              <span>{tier.body}</span>
            </div>
          ))
        }
      </div>
      {
        d.rows.map((r) => (
          <div class="tr" role="row">
            <div class="td svc" role="rowheader">
              <strong>{r.service}</strong>
              <span>{r.note}</span>
            </div>
            {r.prices.map((p, i) => (
              <div class={`td price ${i === 1 ? 'hl' : ''} ${p ? '' : 'empty'}`} role="cell" data-tier={d.tiers[i].name}>
                {p}
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <div class="after reveal">
      <p class="muted">{d.footnote}</p>
      <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener">
        {d.cta} <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
  }
  .table {
    margin-top: 40px;
    border-top: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }
  .tr {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    border-bottom: 1px solid var(--line);
  }
  .tr:last-child {
    border-bottom: 0;
  }
  .th,
  .td {
    padding: 22px 20px;
  }
  .th.svc,
  .td.svc {
    padding-left: 0;
  }
  .tier,
  .svc {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .tier strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 34px;
    line-height: 1;
  }
  .tier span,
  .svc span {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.45;
  }
  .svc strong {
    font-weight: 500;
    font-size: 17px;
  }
  .price {
    display: flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 24px;
  }
  .hl {
    position: relative;
    isolation: isolate;
  }
  .hl::before {
    content: '';
    position: absolute;
    inset: 6px 4px;
    z-index: -1;
    background: var(--p3);
    opacity: 0.28;
    filter: url(#rough);
    transition: background 1s;
  }
  .thead .hl strong::after {
    content: ' ●';
    color: var(--p2);
    font-size: 14px;
    vertical-align: middle;
  }
  .after {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 12px;
  }
  .after p {
    margin: 0;
    max-width: 60ch;
    font-size: 14px;
  }
  @media (max-width: 860px) {
    .thead {
      display: none;
    }
    .tr {
      grid-template-columns: 1fr;
      padding: 10px 0;
    }
    .th,
    .td {
      padding: 8px 0;
    }
    .price.empty {
      display: none;
    }
    .price::before {
      content: attr(data-tier);
      font-family: var(--font-mono);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
      width: 110px;
      flex-shrink: 0;
    }
    .hl::before {
      inset: 0 -6px;
    }
  }
</style>
