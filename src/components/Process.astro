---
import type { Lang } from '../config/site';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).process;
---

<section class="section process">
  <div class="wrap">
    <p class="kicker scramble">{d.kicker}</p>
    <SplitText class="h-lg" text={d.title} />
    <ol class="steps">
      {
        d.steps.map((s, i) => (
          <li class="step spot reveal" style={`--d:${i * 0.1}s`}>
            <span class="n">{s.n}</span>
            <h3 class="h-md">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .step {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 24px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-2);
  }
  .n {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .step p {
    margin: 0;
    color: var(--fg-2);
    font-size: 15px;
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
