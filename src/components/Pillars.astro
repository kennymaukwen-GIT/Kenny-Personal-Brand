---
import type { Lang } from '../config/site';
import { clips, type Clip } from '../config/media';
import { t } from '../i18n';
import LazyVideo from './LazyVideo.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).pillars;
const clipFor: Record<string, Clip> = {
  seen: clips.chrome,
  found: clips.network,
  used: clips.orrery,
};
---

<section class="section pillars" id="what">
  <div class="wrap">
    <p class="kicker reveal">{d.kicker}</p>
    <div class="list">
      {
        d.items.map((p, i) => (
          <article class={`pillar ${i % 2 ? 'flip' : ''}`}>
            <div class="media reveal">
              <LazyVideo src={clipFor[p.key].src} />
              <span class="tag">{p.label}</span>
            </div>
            <div class="text">
              <h3 class="h-lg reveal">{p.title}</h3>
              <p class="lead reveal" style="--d:.1s">
                {p.body}
              </p>
              <ul class="reveal" style="--d:.2s">
                {p.list.map((li) => (
                  <li>{li}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: clamp(80px, 12vw, 160px);
    margin-top: 56px;
  }
  .pillar {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .pillar.flip .media {
    order: 2;
  }
  .media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .tag {
    position: absolute;
    left: 16px;
    top: 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(5, 6, 8, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid var(--line-strong);
  }
  .text {
    display: grid;
    gap: 24px;
  }
  .text .h-lg {
    font-size: clamp(34px, 4.6vw, 64px);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  li {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
    color: var(--fg-2);
  }
  li::before {
    content: '+ ';
    color: var(--accent);
    font-family: var(--font-mono);
  }
  @media (max-width: 860px) {
    .pillar {
      grid-template-columns: 1fr;
    }
    .pillar.flip .media {
      order: 0;
    }
  }
  @media (max-width: 420px) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
