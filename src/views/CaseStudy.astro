---
import Base from '../layouts/Base.astro';
import PaintCanvas from '../components/PaintCanvas.astro';
import { site, type Lang } from '../config/site';
import { t, localePath } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).caseStudy;
const path = '/work/hsinchu-car-dealer';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.metaDescription,
  inLanguage: lang === 'en' ? 'en' : 'zh-Hant-TW',
  author: { '@type': 'Organization', name: site.name, url: site.url },
  about: ['AI SEO', 'Generative engine optimization', 'Used car dealer marketing'],
  mainEntityOfPage: new URL(localePath(lang, path), site.url).href,
};
---

<Base lang={lang} path={path} title={d.metaTitle} description={d.metaDescription} jsonLd={[articleLd]}>
  <article>
    <header class="cs-hero">
      <PaintCanvas interactive seed={7.7} shift={2} scale={1.3} quality={0.5} />
      <div class="wrap">
        <a class="back" href={localePath(lang, '/')}>← {d.back}</a>
        <div class="label-card head-card reveal">
        <p class="kicker">{d.kicker}</p>
        <h1 class="h-lg">{d.title}</h1>
        <dl class="meta">
          <div><dt class="muted">Client</dt><dd>{d.client}</dd></div>
          <div><dt class="muted">Scope</dt><dd>{d.services}</dd></div>
        </dl>
        </div>
      </div>
    </header>

    <section class="section body">
      <div class="wrap narrow">
        {
          d.sections.map((s) => (
            <div class="block reveal">
              <h2 class="h-md">{s.h}</h2>
              <p class="lead">{s.p}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section funnel-sec">
      <div class="wrap">
        <p class="kicker reveal">{d.funnelTitle}</p>
        <ol class="funnel">
          {
            d.funnel.map((f, i) => (
              <li class="reveal" style={`--d:${i * 0.12}s; --w:${100 - i * 22}%; --c:var(--p${i + 1})`}>
                <span class="value">{f.value}</span>
                <span class="label">{f.label}</span>
              </li>
            ))
          }
        </ol>
        <p class="lead reveal">{d.funnelNote}</p>
      </div>
    </section>

    <section class="section ai">
      <div class="wrap narrow">
        <div class="block reveal">
          <h2 class="h-md">{d.aiTitle}</h2>
          <p class="lead">{d.aiBody}</p>
        </div>
        <blockquote class="reveal">“{d.takeaway}”</blockquote>
        <p class="note muted reveal">{d.note}</p>
      </div>
    </section>

    <section class="section cta">
      <div class="wrap">
        <h2 class="h-lg reveal">{d.ctaTitle}</h2>
        <a class="btn btn-primary reveal" style="--d:.1s" href={site.bookingUrl} target="_blank" rel="noopener">
          {d.cta} <span class="arrow">→</span>
        </a>
      </div>
    </section>
  </article>
</Base>

<style>
  .cs-hero {
    position: relative;
    isolation: isolate;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    padding: 120px 0 48px;
    overflow: hidden;
    border-bottom: 1.5px solid var(--ink);
  }
  .cs-hero :global(.paint-wrap) {
    z-index: -1;
  }
  .cs-hero .wrap {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .head-card {
    padding: clamp(20px, 3vw, 36px);
    max-width: 860px;
    display: grid;
    gap: 18px;
  }
  .back {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--paper-3);
    border: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin: 4px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .meta dd {
    margin: 4px 0 0;
  }
  .narrow {
    display: grid;
    gap: 64px;
  }
  .narrow > * {
    max-width: 820px;
  }
  .block {
    display: grid;
    gap: 16px;
  }
  .funnel-sec {
    background: var(--paper-2);
    border-top: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
  }
  .funnel-sec .wrap {
    display: grid;
    gap: 32px;
  }
  .funnel {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .funnel li {
    position: relative;
    isolation: isolate;
    width: var(--w);
    min-width: min(100%, 320px);
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 22px 28px;
    color: var(--paper-3);
  }
  .funnel li::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c);
    filter: url(#rough);
    transition: background 1s;
  }
  .funnel li:nth-child(3) {
    color: var(--ink);
  }
  .funnel .value {
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 88px);
    line-height: 1;
  }
  .funnel .label {
    font-size: 16px;
  }
  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(32px, 4.4vw, 60px);
    line-height: 1.1;
    color: var(--p1);
  }
  html[lang^='zh'] blockquote {
    font-style: normal;
  }
  .note {
    font-size: 14px;
  }
  .cta .wrap {
    display: grid;
    gap: 32px;
    justify-items: start;
  }
</style>
