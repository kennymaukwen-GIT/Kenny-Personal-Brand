---
import type { Lang } from '../config/site';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).process;
---

<section class="section process">
  <div class="wrap">
    <p class="kicker">{d.kicker}</p>
    <SplitText class="h-lg" text={d.title} />
    <ol class="steps">
      {
        d.steps.map((s, i) => (
          <li class="step reveal" style={`--d:${i * 0.1}s`}>
            <span class="n">{s.n}</span>
            <h3 class="h-md">{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 20px;
  }
  .steps {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }
  .step {
    display: grid;
    gap: 10px;
    align-content: start;
    min-height: 240px;
    padding: 20px;
    border-radius: 10px;
    background: var(--g2);
  }
  .n {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 6px;
    background: #fff;
    font-family: var(--font-mono);
    font-size: 12px;
    margin-bottom: 40px;
  }
  .step :global(h3) {
    font-weight: 400;
  }
  .step p {
    margin: 0;
    color: var(--fg-2);
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
