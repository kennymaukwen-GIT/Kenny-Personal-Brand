---
import { site, type Lang } from '../config/site';
import { t, localePath, otherLang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const d = t(lang);
const home = localePath(lang, '/');
const year = new Date().getFullYear();
const social = Object.entries(site.social).filter(([, url]) => url);
const cols = [
  ...d.capabilities.groups.slice(0, 3).map((g) => ({ title: g.name, links: g.items.slice(0, 5).map((i) => ({ label: i.name, href: `${home}#capabilities` })) })),
  {
    title: lang === 'en' ? 'Studio' : '工作室',
    links: [
      { label: d.nav.caseStudy, href: localePath(lang, '/work/hsinchu-car-dealer') },
      { label: d.nav.work, href: `${home}#latest` },
      { label: lang === 'en' ? 'Pricing' : '價格', href: `${home}#services` },
      { label: d.footer.privacy, href: localePath(lang, '/privacy') },
      { label: d.nav.langLabel, href: localePath(otherLang(lang), path) },
    ],
  },
  {
    title: lang === 'en' ? 'Contact' : '聯絡',
    links: [
      { label: site.email, href: `mailto:${site.email}` },
      { label: d.nav.cta, href: site.bookingUrl },
      ...social.map(([name, url]) => ({ label: name, href: url })),
    ],
  },
];
---

<footer class="footer sheet dark">
  <div class="grid">
    <span class="mark" aria-hidden="true"></span>
    {
      cols.map((c) => (
        <div class="col">
          <p class="kicker">{c.title}</p>
          {c.links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="bottom">
    <span>© {year} {site.name}</span>
    <span>{d.footer.built}</span>
  </div>
</footer>

<style>
  .footer {
    padding: 56px 40px 28px;
    font-size: 13px;
  }
  .grid {
    display: grid;
    grid-template-columns: 80px repeat(5, 1fr);
    gap: 32px;
  }
  .mark {
    width: 22px;
    height: 22px;
    background: #fff;
    clip-path: polygon(0 0, 100% 0, 100% 30%, 30% 30%, 30% 100%, 0 100%);
  }
  .col {
    display: grid;
    align-content: start;
    gap: 8px;
  }
  .col .kicker {
    margin-bottom: 6px;
  }
  .col .kicker::before {
    display: none;
  }
  .col a {
    color: #e5e5e5;
  }
  .col a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .bottom {
    margin-top: 72px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
