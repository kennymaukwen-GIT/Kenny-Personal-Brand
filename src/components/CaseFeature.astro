---
import type { Lang } from '../config/site';
import { t, localePath } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).caseFeature;
---

<section class="section case" id="case">
  <div class="wrap">
    <p class="kicker">{d.kicker}</p>
    <SplitText class="h-lg" text={d.title} />
    <p class="lead reveal" style="--d:.1s">{d.body}</p>

    <div class="stats">
      {
        d.stats.map((s, i) => (
          <div class="stat spot reveal" style={`--d:${0.1 + i * 0.08}s`}>
            <span class="value" data-count>{s.value}</span>
            <span class="label">{s.label}</span>
          </div>
        ))
      }
    </div>

    <div class="foot reveal">
      <p class="h-md">“{d.thesis}”</p>
      <a class="btn btn-ghost" href={localePath(lang, '/work/hsinchu-car-dealer')}>
        {d.cta} <span class="arrow">→</span>
      </a>
    </div>
    <p class="note muted">{d.note}</p>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 20px;
  }
  .wrap > :global(.split) {
    max-width: 22ch;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: 32px;
  }
  .stat {
    padding: 24px;
    min-height: 220px;
    border-radius: 10px;
    background: var(--g2);
    display: grid;
    align-content: space-between;
    gap: 12px;
  }
  .value {
    font-size: clamp(44px, 5vw, 64px);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .label {
    color: var(--fg-2);
    font-size: 15px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 8px;
  }
  .foot p {
    margin: 0;
  }
  .note {
    font-size: 12px;
    margin: 0;
  }
  @media (max-width: 720px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
