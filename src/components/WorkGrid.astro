---
import type { Lang } from '../config/site';
import { reel } from '../config/media';
import { t } from '../i18n';
import LazyVideo from './LazyVideo.astro';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).work;
---

<section class="section" id="work">
  <div class="wrap">
    <p class="kicker reveal">{d.kicker}</p>
    <SplitText class="h-lg" text={d.title} />
    <p class="lead reveal" style="--d:.1s">{d.sub}</p>

    <div class="grid">
      {
        reel.map((c, i) => (
          <figure class="tile reveal" style={`--d:${(i % 3) * 0.06}s`}>
            <div class="panel media spot">
              <LazyVideo src={c.src} mode="hover" label={`${c.title[lang]} — ${c.genre[lang]}`} />
            </div>
            <figcaption>
              <span>{c.title[lang]}</span>
              <span class="muted">{c.genre[lang]}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
  }
  h2 {
    max-width: 18ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 20px;
    margin-top: 32px;
  }
  .tile {
    margin: 0;
    cursor: pointer;
  }
  .media {
    aspect-ratio: 16 / 10;
  }
  .tile :global(video) {
    transition: opacity 0.4s, transform 0.8s var(--ease);
    opacity: 0.8;
  }
  .tile:hover :global(video),
  .tile.playing :global(video) {
    opacity: 1;
    transform: scale(1.03);
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    font-size: 14px;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
