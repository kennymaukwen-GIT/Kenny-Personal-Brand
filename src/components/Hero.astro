---
// Pinned scroll film: the particle cloud forms a globe, then spells SEEN. FOUND.
// USED. while captions explain each pillar, then explodes into the next section.
import { site, type Lang } from '../config/site';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const h = d.hero;
const caps = d.pillars.items;
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="stage">
    <canvas class="globe" data-globe aria-hidden="true"></canvas>
    <div class="glow" aria-hidden="true"></div>

    <div class="wrap intro" data-hero-intro>
      <p class="kicker scramble"><span class="pill">AI Studio</span>{h.eyebrow}</p>
      <SplitText tag="h1" id="hero-title" class="h-xl" text={h.title.join(' ')} delay={0.1} />
      <p class="lead reveal" style="--d:.5s">{h.sub}</p>
      <div class="ctas reveal" style="--d:.65s">
        <a class="btn btn-primary magnetic" href={site.bookingUrl} target="_blank" rel="noopener">
          {h.primary} <span class="arrow">→</span>
        </a>
        <a class="btn btn-ghost magnetic" href="#work">{h.secondary}</a>
      </div>
    </div>

    <div class="wrap captions" aria-hidden="true">
      {
        caps.map((c, i) => (
          <div class="cap" data-cap={i}>
            <span class="num">0{i + 1} / 03</span>
            <strong>{c.title}</strong>
            <span class="muted">{c.list.slice(0, 3).join(' · ')}</span>
          </div>
        ))
      }
    </div>

    <div class="wrap hud" aria-hidden="true">
      <span class="mono" data-hud-count>0 particles</span>
      <span class="track"><span class="fill" data-hero-fill></span></span>
      <span class="mono" data-hud-pct>000%</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 420vh;
  }
  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .globe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
  .glow {
    position: absolute;
    z-index: -2;
    left: 50%;
    top: 50%;
    width: 900px;
    height: 900px;
    transform: translate(-30%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 108, 255, 0.18), transparent 62%);
    filter: blur(30px);
    animation: breathe 6s ease-in-out infinite;
  }
  @keyframes breathe {
    50% {
      opacity: 0.6;
      transform: translate(-30%, -50%) scale(1.1);
    }
  }
  .intro {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(calc(-50% + var(--lift, 0px)));
    opacity: var(--fade, 1);
    filter: blur(calc((1 - var(--fade, 1)) * 12px));
    display: grid;
    gap: 24px;
    justify-items: start;
    pointer-events: auto;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(8px);
    color: var(--fg-2);
    font-size: 13px;
  }
  .pill {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
  }
  .hero :global(h1) {
    max-width: 11ch;
  }
  .lead {
    max-width: 46ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .captions {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 110px;
    pointer-events: none;
  }
  .cap {
    position: absolute;
    left: var(--gutter);
    bottom: 0;
    display: grid;
    gap: 8px;
    max-width: 520px;
    opacity: 0;
    transform: translateY(24px);
    filter: blur(8px);
    transition:
      opacity 0.6s var(--ease),
      transform 0.6s var(--ease),
      filter 0.6s var(--ease);
  }
  .cap.on {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }
  .cap strong {
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .cap .muted {
    font-size: 14px;
  }
  .hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    min-width: 120px;
  }
  .mono:last-child {
    text-align: right;
  }
  .track {
    flex: 1;
    height: 1px;
    background: var(--line);
    position: relative;
  }
  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--accent), #fff);
    transform-origin: left;
    transform: scaleX(0);
  }
  @media (max-width: 860px) {
    .glow {
      transform: translate(-50%, -50%);
      width: 600px;
      height: 600px;
    }
    .intro {
      top: auto;
      bottom: 120px;
      transform: translateY(var(--lift, 0px));
    }
    .captions {
      bottom: 90px;
    }
    .mono:first-child {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .stage {
      position: relative;
      height: 100svh;
    }
    .captions,
    .hud {
      display: none;
    }
  }
</style>
