---
import { site, type Lang } from '../config/site';
import { t, localePath, otherLang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const d = t(lang);
const home = localePath(lang, '/');
const links = [
  { href: `${home}#work`, label: d.nav.work },
  { href: `${home}#capabilities`, label: d.nav.services },
  { href: localePath(lang, '/work/hsinchu-car-dealer'), label: d.nav.caseStudy },
  { href: `${home}#building`, label: d.nav.building },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a class="brand" href={home} aria-label={site.name}>
      <span class="brand-mark" aria-hidden="true"></span>
      {site.name}
    </a>
    <nav class="links" aria-label="Primary">
      {links.map((l) => <a class="scramble-hover" href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a class="lang" href={localePath(otherLang(lang), path)} hreflang={otherLang(lang) === 'en' ? 'en' : 'zh-Hant-TW'}>
        {d.nav.langLabel}
      </a>
      <a class="btn btn-primary nav-cta" href={site.bookingUrl} target="_blank" rel="noopener">
        {d.nav.cta}
      </a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 0 var(--gutter);
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .nav.scrolled {
    border-color: var(--line);
  }
  .nav {
    transition:
      border-color 0.3s,
      transform 0.5s var(--ease);
  }
  .nav.hidden {
    transform: translateY(-100%);
  }
  .links a {
    font-variant-numeric: tabular-nums;
  }
  .nav-inner {
    max-width: var(--max);
    height: 64px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  .brand-mark {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background: var(--fg);
  }
  .links {
    display: flex;
    gap: 28px;
    font-size: 14px;
    color: var(--fg-2);
  }
  .links a:hover {
    color: var(--fg);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .lang {
    font-size: 14px;
    color: var(--fg-2);
  }
  .lang:hover {
    color: var(--fg);
  }
  .nav-cta {
    height: 36px;
    padding: 0 14px;
    font-size: 14px;
  }
  @media (max-width: 860px) {
    .links {
      display: none;
    }
  }
</style>
