---
import { site, type Lang } from '../config/site';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).hero;
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="globe" data-globe aria-hidden="true"></canvas>
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <p class="kicker reveal"><span class="pill">New</span>{d.eyebrow}</p>
    <SplitText tag="h1" id="hero-title" class="h-xl" text={d.title.join(' ')} delay={0.1} />
    <p class="lead reveal" style="--d:.5s">{d.sub}</p>
    <div class="ctas reveal" style="--d:.65s">
      <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener">
        {d.primary} <span class="arrow">→</span>
      </a>
      <a class="btn btn-ghost" href="#work">{d.secondary}</a>
    </div>
  </div>
  <div class="scroll-cue" aria-hidden="true"><span></span></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
    overflow: hidden;
    isolation: isolate;
  }
  .globe {
    position: absolute;
    z-index: -1;
    top: 0;
    right: -8%;
    width: 72%;
    height: 100%;
  }
  .glow {
    position: absolute;
    z-index: -2;
    right: 10%;
    top: 50%;
    width: 640px;
    height: 640px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 108, 255, 0.16), transparent 65%);
    filter: blur(20px);
  }
  .wrap {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.03);
    color: var(--fg-2);
    font-size: 13px;
  }
  .pill {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
  }
  .hero :global(h1) {
    max-width: 11ch;
  }
  .lead {
    max-width: 46ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 1px;
    height: 48px;
    background: var(--line);
    overflow: hidden;
  }
  .scroll-cue span {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, var(--fg));
    animation: cue 2s var(--ease) infinite;
  }
  @keyframes cue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }
  @media (max-width: 860px) {
    .globe {
      right: -30%;
      width: 130%;
      opacity: 0.5;
    }
  }
</style>
