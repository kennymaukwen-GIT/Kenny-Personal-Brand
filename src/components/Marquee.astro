---
import type { Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const items = t(Astro.props.lang).marquee;
// Repeat so the loop is seamless at any screen width.
const loop = [...items, ...items];
---

<div class="marquee" aria-label={items.join(', ')}>
  <div class="marquee-track" aria-hidden="true">
    {
      loop.map((item) => (
        <span class="item">
          {item}
          <span class="star">✦</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 22px 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .item {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--fg-2);
    white-space: nowrap;
  }
  .star {
    color: var(--accent);
    font-size: 0.6em;
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
