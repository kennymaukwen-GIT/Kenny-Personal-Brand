---
import Base from '../layouts/Base.astro';
import { site, type Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).privacy;
---

<Base lang={lang} path="/privacy" title={d.title}>
  <section class="section">
    <div class="wrap narrow">
      <h1 class="h-lg">{d.title}</h1>
      <p class="muted">{d.updated}</p>
      {d.body.map((p) => <p class="lead">{p}</p>)}
      <p class="lead"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 760px;
    display: grid;
    gap: 20px;
    padding-top: 80px;
  }
  a {
    color: var(--accent);
  }
</style>
