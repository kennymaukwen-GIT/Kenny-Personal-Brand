---
// Static capability strip (a quiet stand-in for a logo bar).
import type { Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const items = t(Astro.props.lang).marquee;
---

<div class="strip">
  <ul class="wrap">
    {items.map((item) => <li>{item}</li>)}
  </ul>
</div>

<style>
  .strip {
    border-top: 1px solid var(--line);
    padding: 28px 0;
  }
  ul {
    list-style: none;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    color: var(--muted);
    font-size: 15px;
    font-weight: 500;
  }
</style>
