---
import Base from '../layouts/Base.astro';
import PaintCanvas from '../components/PaintCanvas.astro';
import { t } from '../i18n';

const d = t('en').notFound;
---

<Base lang="en" path="/404" title={d.title}>
  <section class="nf">
    <PaintCanvas interactive seed={40.4} scale={1.2} />
    <div class="wrap label-card inner">
      <p class="kicker">404</p>
      <h1 class="h-xl">{d.title}</h1>
      <p class="lead">{d.body}</p>
      <a class="btn btn-primary" href="/">{d.cta} <span class="arrow">→</span></a>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .nf :global(.paint-wrap) {
    z-index: -1;
  }
  .inner {
    width: auto;
    max-width: 640px;
    margin-left: var(--gutter);
    padding: 32px;
    display: grid;
    gap: 24px;
    justify-items: start;
  }
</style>
