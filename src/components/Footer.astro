---
import { site, type Lang } from '../config/site';
import { t, localePath, otherLang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const social = Object.entries(site.social).filter(([, url]) => url);
---

<footer class="footer">
  <div class="wrap">
    <div class="row">
      <div class="col">
        <strong>{site.name}</strong>
        <span class="muted">{site.location}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="col links">
        {social.map(([name, url]) => <a href={url} target="_blank" rel="noopener">{name}</a>)}
        <a href={localePath(lang, '/privacy')}>{d.footer.privacy}</a>
        <a href={localePath(otherLang(lang), path)}>{d.nav.langLabel}</a>
      </div>
    </div>
    <div class="row small muted">
      <span>© {year} {site.name}. {d.footer.rights}</span>
      <span class="built"><span class="dot"></span>{d.footer.built}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 56px 0 32px;
    font-size: 14px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--fg-2);
  }
  .col strong {
    color: var(--fg);
    font-weight: 500;
  }
  .links {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 24px;
    text-transform: capitalize;
  }
  .links a:hover,
  .col a:hover {
    color: var(--fg);
  }
  .small {
    margin: 0;
    font-size: 13px;
  }
  .built {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
