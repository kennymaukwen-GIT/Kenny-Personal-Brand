---
import type { Lang } from '../config/site';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const items = t(Astro.props.lang).marquee;
const loop = [...items, ...items];
---

<div class="marquee" aria-label={items.join(', ')}>
  <div class="track" aria-hidden="true">
    {loop.map((item) => <span>{item}</span>)}
  </div>
</div>

<style>
  .marquee {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 28px 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
  .track {
    display: flex;
    gap: 64px;
    width: max-content;
    animation: slide 36s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  span {
    color: var(--muted);
    font-size: 18px;
    font-weight: 500;
    white-space: nowrap;
  }
  @keyframes slide {
    to {
      transform: translateX(calc(-50% - 32px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
  }
</style>
