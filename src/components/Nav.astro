---
import { site, type Lang } from '../config/site';
import { t, localePath, otherLang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const d = t(lang);
const home = localePath(lang, '/');
const links = [
  { href: `${home}#capabilities`, label: d.nav.services },
  { href: `${home}#latest`, label: d.nav.work },
  { href: localePath(lang, '/work/hsinchu-car-dealer'), label: d.nav.caseStudy },
  { href: `${home}#services`, label: lang === 'en' ? 'Pricing' : '價格' },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a class="brand" href={home} aria-label={site.name}>
      <span class="mark" aria-hidden="true"></span>
      <span class="name">{site.shortName.toLowerCase()}</span>
    </a>
    <nav class="links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a class="btn btn-outline small" href={localePath(otherLang(lang), path)} hreflang={otherLang(lang) === 'en' ? 'en' : 'zh-Hant-TW'}>
        {d.nav.langLabel}
      </a>
      <a class="btn btn-primary small" href={site.bookingUrl} target="_blank" rel="noopener">{d.nav.cta}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      transform 0.5s var(--ease),
      background 0.3s;
  }
  .nav.hidden {
    transform: translateY(-100%);
  }
  .nav-inner {
    height: 60px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: 40px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .mark {
    width: 14px;
    height: 14px;
    background: #000;
    clip-path: polygon(0 0, 100% 0, 100% 30%, 30% 30%, 30% 100%, 0 100%);
  }
  .name {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .links {
    display: flex;
    gap: 28px;
    font-size: 14px;
  }
  .links a {
    color: #222;
  }
  .links a:hover {
    color: var(--muted);
  }
  .actions {
    margin-left: auto;
    display: flex;
    gap: 8px;
  }
  .small {
    height: 34px;
    padding: 0 14px;
    font-size: 14px;
    border-radius: 6px;
  }
  @media (max-width: 820px) {
    .links {
      display: none;
    }
  }
</style>
