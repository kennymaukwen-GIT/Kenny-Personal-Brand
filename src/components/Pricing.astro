---
import { site, type Lang } from '../config/site';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).pricing;
---

<section class="section pricing" id="services">
  <div class="wrap">
    <p class="kicker">{d.kicker}</p>
    <SplitText class="h-lg" text={d.title} />
    <p class="lead reveal" style="--d:.2s">{d.sub}</p>

    <div class="table reveal" role="table" aria-label={d.title}>
      <div class="tr thead" role="row">
        <div class="th svc" role="columnheader"></div>
        {
          d.tiers.map((tier, i) => (
            <div class={`th tier ${i === 1 ? 'hl' : ''}`} role="columnheader">
              <strong>{tier.name}</strong>
              <span>{tier.body}</span>
            </div>
          ))
        }
      </div>
      {
        d.rows.map((r) => (
          <div class="tr" role="row">
            <div class="td svc" role="rowheader">
              <strong>{r.service}</strong>
              <span>{r.note}</span>
            </div>
            {r.prices.map((p, i) => (
              <div class={`td price ${i === 1 ? 'hl' : ''} ${p ? '' : 'empty'}`} role="cell" data-tier={d.tiers[i].name}>
                {p}
              </div>
            ))}
          </div>
        ))
      }
    </div>

    <div class="after reveal">
      <p class="muted">{d.footnote}</p>
      <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener">
        {d.cta} <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 20px;
  }
  .table {
    margin-top: 32px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--g2);
  }
  .tr {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    border-bottom: 1px solid var(--line);
  }
  .tr:last-child {
    border-bottom: 0;
  }
  .thead {
    background: var(--g3);
  }
  .th,
  .td {
    padding: 18px 22px;
  }
  .tier,
  .svc {
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .tier strong {
    font-weight: 500;
    font-size: 16px;
  }
  .tier span,
  .svc span {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.45;
  }
  .svc strong {
    font-weight: 500;
  }
  .price {
    display: flex;
    align-items: center;
    font-size: 15px;
  }
  .hl {
    background: #fff;
  }
  .thead .hl {
    background: #000;
    color: #fff;
  }
  .thead .hl span {
    color: #a1a1a1;
  }
  .after {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }
  .after p {
    margin: 0;
    max-width: 60ch;
    font-size: 13px;
  }
  @media (max-width: 860px) {
    .thead {
      display: none;
    }
    .tr {
      grid-template-columns: 1fr;
      padding: 8px 0;
    }
    .th,
    .td {
      padding: 8px 18px;
    }
    .price.empty {
      display: none;
    }
    .price::before {
      content: attr(data-tier);
      color: var(--muted);
      width: 96px;
      flex-shrink: 0;
    }
    .hl {
      background: transparent;
    }
  }
</style>
