---
import { site, type Lang } from '../config/site';
import { heroClip } from '../config/media';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <p class="kicker reveal">{d.eyebrow}</p>
    <h1 id="hero-title" class="h-xl reveal" style="--d:.05s">{d.title.join(' ')}</h1>
    <p class="lead reveal" style="--d:.1s">{d.sub}</p>
    <div class="ctas reveal" style="--d:.15s">
      <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener">
        {d.primary} <span class="arrow">→</span>
      </a>
      <a class="btn btn-ghost" href="#work">{d.secondary}</a>
    </div>
    <div class="panel media reveal" style="--d:.25s" aria-hidden="true">
      <video class="vid" src={heroClip.src} autoplay muted loop playsinline preload="auto"></video>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 160px 0 0;
  }
  .wrap {
    display: grid;
    gap: 24px;
    justify-items: start;
  }
  h1 {
    max-width: 14ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .media {
    width: 100%;
    aspect-ratio: 21 / 9;
    margin: 56px 0 clamp(80px, 10vw, 140px);
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 120px;
    }
    .media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
