---
import { site, type Lang } from '../config/site';
import { t, localePath, otherLang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const d = t(lang);
const home = localePath(lang, '/');
const links = [
  { href: `${home}#work`, label: d.nav.work },
  { href: `${home}#services`, label: d.nav.services },
  { href: localePath(lang, '/work/hsinchu-car-dealer'), label: d.nav.caseStudy },
  { href: `${home}#building`, label: d.nav.building },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a class="brand" href={home} aria-label={site.name}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{site.shortName}<span class="it">&nbsp;Studio</span></span>
    </a>
    <nav class="links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a class="lang" href={localePath(otherLang(lang), path)} hreflang={otherLang(lang) === 'en' ? 'en' : 'zh-Hant-TW'}>
        {d.nav.langLabel}
      </a>
      <a class="btn btn-primary nav-cta" href={site.bookingUrl} target="_blank" rel="noopener">
        {d.nav.cta}
      </a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 14px var(--gutter);
    transition: background 0.4s, border-color 0.4s;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: rgba(238, 231, 218, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-color: var(--line);
  }
  .nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1;
    padding: 6px 12px 6px 8px;
    border-radius: 999px;
    background: var(--paper-3);
    border: 1px solid var(--line);
  }
  .brand-mark {
    width: 20px;
    height: 20px;
    border-radius: 52% 48% 45% 55%;
    background: conic-gradient(from 20deg, var(--p1), var(--p2), var(--p3), var(--p1));
    animation: spin 12s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .links {
    display: flex;
    gap: 4px;
    padding: 4px;
    font-size: 15px;
    border-radius: 999px;
    background: var(--paper-3);
    border: 1px solid var(--line);
  }
  .links a {
    padding: 6px 14px;
    border-radius: 999px;
    transition: background 0.3s;
  }
  .links a:hover {
    background: var(--paper-2);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--paper-3);
    border: 1px solid var(--line);
  }
  .nav-cta {
    height: 40px;
    padding: 0 18px;
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .links {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .brand-name .it {
      display: none;
    }
    .nav-cta {
      padding: 0 14px;
    }
  }
</style>
