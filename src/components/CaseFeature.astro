---
import type { Lang } from '../config/site';
import { clips } from '../config/media';
import { t, localePath } from '../i18n';
import LazyVideo from './LazyVideo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).caseFeature;
---

<section class="section case" id="case">
  <div class="bg" aria-hidden="true">
    <LazyVideo src={clips.concept.src} />
    <div class="bg-shade"></div>
  </div>
  <div class="wrap">
    <p class="kicker reveal">{d.kicker}</p>
    <h2 class="h-lg title reveal" style="--d:.1s">{d.title}</h2>
    <p class="lead reveal" style="--d:.2s">{d.body}</p>

    <div class="stats">
      {
        d.stats.map((s, i) => (
          <div class="stat reveal" style={`--d:${0.1 + i * 0.1}s`}>
            <span class="value">{s.value}</span>
            <span class="label">{s.label}</span>
          </div>
        ))
      }
    </div>

    <div class="foot reveal">
      <p class="quote serif">“{d.thesis}”</p>
      <div class="foot-right">
        <a class="btn btn-ghost" href={localePath(lang, '/work/hsinchu-car-dealer')}>
          {d.cta} <span class="arrow">→</span>
        </a>
        <p class="note muted">{d.note}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .case {
    overflow: hidden;
    isolation: isolate;
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.35;
  }
  .bg-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--bg) 0%, rgba(5, 6, 8, 0.7) 30%, rgba(5, 6, 8, 0.7) 70%, var(--bg) 100%);
  }
  .wrap {
    display: grid;
    gap: 28px;
  }
  .title {
    max-width: 16ch;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-strong);
    margin-top: 24px;
  }
  .stat {
    padding: 32px 24px 32px 0;
    display: grid;
    gap: 10px;
    border-right: 1px solid var(--line);
  }
  .stat:not(:first-child) {
    padding-left: 24px;
  }
  .stat:last-child {
    border-right: 0;
  }
  .value {
    font-size: clamp(48px, 7vw, 104px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    background: linear-gradient(180deg, #fff, var(--beacon));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .label {
    color: var(--fg-2);
    font-size: 15px;
    max-width: 22ch;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    margin-top: 24px;
  }
  .quote {
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.15;
    margin: 0;
    max-width: 20ch;
  }
  .foot-right {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .note {
    font-size: 13px;
    margin: 0;
  }
  @media (max-width: 720px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stat,
    .stat:not(:first-child) {
      padding: 24px 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
