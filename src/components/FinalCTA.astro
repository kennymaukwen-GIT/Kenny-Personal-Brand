---
import { site, type Lang } from '../config/site';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).final;
// Without a newsletter service yet, the form falls back to opening an email.
const action = site.newsletterAction || `mailto:${site.email}?subject=Build%20Log`;
const method = site.newsletterAction ? 'post' : 'get';
---

<section class="section final">
  <div class="wrap">
    <div class="tilt" data-tilt>
      <SplitText class="h-xl mega" text={d.title.join(' ')} />
      <span class="sheen" aria-hidden="true"></span>
    </div>
    <p class="lead reveal" style="--d:.05s">{d.sub}</p>
    <a class="btn btn-primary big magnetic reveal" style="--d:.1s" href={site.bookingUrl} target="_blank" rel="noopener">
      {d.primary} <span class="arrow">→</span>
    </a>

    <form class="news reveal" id="buildlog" action={action} method={method}>
      <div>
        <strong>{d.newsletterTitle}</strong>
        <span class="muted">{d.newsletterBody}</span>
      </div>
      <div class="field">
        <label class="sr-only" for="email">Email</label>
        <input id="email" name="email" type="email" required placeholder={d.newsletterPlaceholder} autocomplete="email" />
        <button class="btn btn-ghost" type="submit">{d.newsletterButton}</button>
      </div>
    </form>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
    justify-items: center;
    text-align: center;
  }
  .final {
    padding: clamp(120px, 16vw, 240px) 0 clamp(80px, 10vw, 140px);
    overflow: hidden;
  }
  .tilt {
    position: relative;
    perspective: 900px;
  }
  .tilt :global(.mega) {
    font-size: clamp(56px, 11vw, 168px);
    max-width: 12ch;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.4s var(--ease);
    background: radial-gradient(600px circle at var(--sx, 50%) var(--sy, 50%), #fff 0%, #c4bcff 30%, #6b6b78 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sheen {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background: radial-gradient(400px circle at var(--sx, 50%) var(--sy, 50%), rgba(124, 108, 255, 0.25), transparent 60%);
    filter: blur(30px);
    pointer-events: none;
  }
  .big {
    height: 56px;
    padding: 0 28px;
    font-size: 16px;
  }
  .news {
    margin-top: 72px;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    text-align: left;
  }
  .news > div:first-child {
    display: grid;
    gap: 2px;
  }
  .news .muted {
    font-size: 14px;
  }
  .field {
    display: flex;
    gap: 8px;
    flex: 1;
    max-width: 440px;
    min-width: 260px;
  }
  input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid var(--line-strong);
    background: var(--bg-2);
  }
  input:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>
