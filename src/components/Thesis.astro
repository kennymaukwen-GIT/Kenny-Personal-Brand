---
import type { Lang } from '../config/site';
import { t } from '../i18n';
import SplitText from './SplitText.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).thesis;
---

<section class="section">
  <div class="wrap">
    <p class="kicker scramble">{d.kicker}</p>
    <SplitText class="h-lg" text={`${d.line} ${d.accent}`} />
    <p class="lead reveal" style="--d:.1s">{d.body}</p>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    gap: 24px;
  }
  h2 {
    max-width: 20ch;
  }
</style>
