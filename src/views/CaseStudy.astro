---
import Base from '../layouts/Base.astro';
import LazyVideo from '../components/LazyVideo.astro';
import { site, type Lang } from '../config/site';
import { clips } from '../config/media';
import { t, localePath } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).caseStudy;
const path = '/work/hsinchu-car-dealer';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.metaDescription,
  inLanguage: lang === 'en' ? 'en' : 'zh-Hant-TW',
  author: { '@type': 'Organization', name: site.name, url: site.url },
  about: ['AI SEO', 'Generative engine optimization', 'Used car dealer marketing'],
  mainEntityOfPage: new URL(localePath(lang, path), site.url).href,
};
---

<Base lang={lang} path={path} title={d.metaTitle} description={d.metaDescription} jsonLd={[articleLd]}>
  <article>
    <header class="cs-hero">
      <div class="bg" aria-hidden="true">
        <LazyVideo src={clips.concept.src} />
        <div class="bg-shade"></div>
      </div>
      <div class="wrap">
        <a class="back" href={localePath(lang, '/')}>← {d.back}</a>
        <p class="kicker reveal">{d.kicker}</p>
        <h1 class="h-lg reveal" style="--d:.1s">{d.title}</h1>
        <dl class="meta reveal" style="--d:.2s">
          <div><dt class="muted">Client</dt><dd>{d.client}</dd></div>
          <div><dt class="muted">Scope</dt><dd>{d.services}</dd></div>
        </dl>
      </div>
    </header>

    <section class="section body">
      <div class="wrap narrow">
        {
          d.sections.map((s) => (
            <div class="block reveal">
              <h2 class="h-md">{s.h}</h2>
              <p class="lead">{s.p}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section funnel-sec">
      <div class="wrap">
        <p class="kicker reveal">{d.funnelTitle}</p>
        <ol class="funnel">
          {
            d.funnel.map((f, i) => (
              <li class="reveal" style={`--d:${i * 0.12}s; --w:${100 - i * 22}%`}>
                <span class="value">{f.value}</span>
                <span class="label">{f.label}</span>
              </li>
            ))
          }
        </ol>
        <p class="lead reveal">{d.funnelNote}</p>
      </div>
    </section>

    <section class="section ai">
      <div class="wrap narrow">
        <div class="block reveal">
          <h2 class="h-md">{d.aiTitle}</h2>
          <p class="lead">{d.aiBody}</p>
        </div>
        <blockquote class="serif reveal">“{d.takeaway}”</blockquote>
        <p class="note muted reveal">{d.note}</p>
      </div>
    </section>

    <section class="section cta">
      <div class="wrap">
        <h2 class="h-lg reveal">{d.ctaTitle}</h2>
        <a class="btn btn-primary reveal" style="--d:.1s" href={site.bookingUrl} target="_blank" rel="noopener">
          {d.cta} <span class="arrow">→</span>
        </a>
      </div>
    </section>
  </article>
</Base>

<style>
  .cs-hero {
    position: relative;
    isolation: isolate;
    min-height: 82svh;
    display: flex;
    align-items: flex-end;
    padding: 140px 0 64px;
    overflow: hidden;
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.6;
  }
  .bg-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--bg) 5%, rgba(5, 6, 8, 0.55) 60%, rgba(5, 6, 8, 0.8) 100%);
  }
  .cs-hero .wrap {
    display: grid;
    gap: 24px;
  }
  .cs-hero h1 {
    max-width: 18ch;
  }
  .back {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-2);
    margin-bottom: 24px;
  }
  .back:hover {
    color: var(--fg);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 8px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .meta dd {
    margin: 4px 0 0;
  }
  .narrow {
    display: grid;
    gap: 64px;
  }
  .narrow > * {
    max-width: 820px;
  }
  .block {
    display: grid;
    gap: 16px;
  }
  .body {
    padding-top: 64px;
  }
  .funnel-sec .wrap {
    display: grid;
    gap: 32px;
  }
  .funnel {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .funnel li {
    width: var(--w);
    min-width: min(100%, 300px);
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 24px 28px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(90deg, rgba(91, 140, 255, 0.14), rgba(255, 181, 71, 0.08));
  }
  .funnel .value {
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .funnel .label {
    color: var(--fg-2);
  }
  blockquote {
    margin: 0;
    font-size: clamp(30px, 4vw, 54px);
    line-height: 1.15;
  }
  .note {
    font-size: 14px;
  }
  .cta .wrap {
    display: grid;
    gap: 32px;
    justify-items: start;
  }
</style>
