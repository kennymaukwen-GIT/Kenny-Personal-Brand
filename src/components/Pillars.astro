---
import type { Lang } from '../config/site';
import { clips, type Clip } from '../config/media';
import { t } from '../i18n';
import LazyVideo from './LazyVideo.astro';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).pillars;
const clipFor: Record<string, Clip> = {
  seen: clips.chrome,
  found: clips.network,
  used: clips.orrery,
};
---

<section class="section" id="what">
  <div class="wrap">
    <p class="kicker reveal">{d.kicker}</p>
    <div class="grid">
      {
        d.items.map((p, i) => (
          <article class="card reveal" style={`--d:${i * 0.08}s`}>
            <div class="panel media">
              <LazyVideo src={clipFor[p.key].src} />
            </div>
            <p class="label muted">{p.label}</p>
            <h3 class="h-md">{p.title}</h3>
            <p class="body">{p.body}</p>
            <ul>
              {p.list.map((li) => (
                <li>{li}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
  }
  .card {
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .media {
    aspect-ratio: 4 / 3;
    margin-bottom: 12px;
  }
  .label {
    margin: 0;
    font-size: 13px;
    font-family: var(--font-mono);
  }
  .body {
    margin: 0;
    color: var(--fg-2);
    font-size: 15px;
  }
  ul {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    color: var(--fg-2);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }
</style>
